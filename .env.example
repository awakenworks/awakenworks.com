# Umami analytics (privacy-first, no cookies, GDPR-friendly).
# Copy to `.env` and fill in. Only loaded in production builds.

# Website UUID from your Umami dashboard (Settings → Websites → your site).
# Without this, analytics is disabled.
PUBLIC_UMAMI_WEBSITE_ID=

# Script URL. Defaults to Umami Cloud when unset.
# Self-hosted example: https://analytics.awakenworks.com/script.js
# PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js

# Opportunity form endpoint. Defaults to the current Formspree inbox when unset.
# Replace with the first-party CRM intake endpoint when that service is ready.
PUBLIC_OPPORTUNITY_ENDPOINT=https://formspree.io/f/mrewzorl
