# Umami analytics (privacy-first, no cookies, GDPR-friendly).
# Copy to `.env` and fill in. Only loaded in production builds.

# The website already uses the configured Umami Cloud ID and script from
# src/config/analytics.mjs. Override only for another website or self-hosting.
# PUBLIC_UMAMI_WEBSITE_ID=59dd9ed4-a538-4fd3-98f4-c9ab7ded1d57

# Script URL. Defaults to Umami Cloud when unset.
# Self-hosted example: https://analytics.awakenworks.com/script.js
# PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js

# Release-gate credential for querying the analytics data plane. Keep this in
# the GitHub `github-pages` environment; never expose it as a PUBLIC_ variable.
# UMAMI_API_KEY=
# UMAMI_API_CLIENT_ENDPOINT=https://api.umami.is/v1
# UMAMI_SEND_ENDPOINT=https://cloud.umami.is/api/send
# UMAMI_WEBSITE_ID=59dd9ed4-a538-4fd3-98f4-c9ab7ded1d57

# Opportunity form endpoint. Defaults to the current Formspree inbox when unset.
# Replace with the first-party CRM intake endpoint when that service is ready.
PUBLIC_OPPORTUNITY_ENDPOINT=https://formspree.io/f/mrewzorl

# Exact website source commit embedded into every production page. The Pages
# workflow supplies github.sha; local builds intentionally default to `local`.
# PUBLIC_AWAKENWORKS_BUILD_REVISION=0123456789abcdef0123456789abcdef01234567
