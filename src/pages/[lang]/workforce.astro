---
import Base from '../../layouts/Base.astro';
import WorkforceLanding from '../../components/WorkforceLanding.astro';
import { content } from '../../i18n/content';
import { localizedStaticPaths, localePath, type Lang } from '../../i18n/locales';
import { softwareAppLd } from '../../lib/jsonld';

export const getStaticPaths = localizedStaticPaths;
const { lang } = Astro.props as { lang: Lang };
const o = content[lang].landing.workforce;
---

<Base title={`Awaken Workforce — ${o.title}`} description={o.subtitle} jsonLd={softwareAppLd({ product: 'workforce', description: o.subtitle, url: new URL(localePath(lang, '/workforce'), Astro.site).href })}>
  <WorkforceLanding lang={lang} />
</Base>
