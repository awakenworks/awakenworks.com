---
import IntegrationsIndex from '../../../components/IntegrationsIndex.astro';
import { content } from '../../../i18n/content';
import { localizedStaticPaths, type Lang } from '../../../i18n/locales';
import Base from '../../../layouts/Base.astro';

export const getStaticPaths = localizedStaticPaths;
const { lang } = Astro.props as { lang: Lang };
const t = content[lang];
---

<Base title={t.integrations.meta.title} description={t.integrations.meta.description}>
  <IntegrationsIndex lang={lang} />
</Base>
