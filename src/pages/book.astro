---
import BookLanding from '../components/BookLanding.astro';
import Base from '../layouts/Base.astro';
import { DEFAULT_LANG } from '../i18n/locales';
import { ui } from '../i18n/ui';

const { title, description } = ui[DEFAULT_LANG].routes.book;
---

<Base title={title} description={description}>
  <BookLanding lang={DEFAULT_LANG} />
</Base>
