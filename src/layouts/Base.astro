---
import '../styles/global.css';
import { appearanceBootstrap } from '@awaken/ui/brand/appearance';
import { DEFAULT_UMAMI_SCRIPT_URL, DEFAULT_UMAMI_WEBSITE_ID } from '../config/analytics.mjs';
import { withSiteBase } from '../config/siteDeployment.mjs';
import {
  DEFAULT_LANG,
  LANGS,
  localeFromPath,
  localePath,
  localeRegistry,
  unlocalizedPath,
} from '../i18n/locales';
import { ui } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  // OpenGraph overrides — default to a site-wide website card.
  ogType?: string;
  ogImage?: string;
  // Article metadata (only emitted when ogType === 'article').
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  // Structured data (JSON-LD) for this page, serialised into <head>.
  jsonLd?: object;
}

const {
  title,
  description,
  ogType = 'website',
  ogImage = '/og.png',
  publishedTime,
  modifiedTime,
  author,
  jsonLd,
} = Astro.props;
const isArticle = ogType === 'article';
const path = Astro.url.pathname;
const rawPath = path.replace(/\/+$/, '') || '/';
const lang = localeFromPath(rawPath);
const locale = localeRegistry[lang];
const basePath = unlocalizedPath(rawPath);

// Brand identity is chosen by route. Product pages use their product UI
// direction; the company/home/docs pages stay on the neutral Works identity.
const brand = /^\/workforce(\/|$)/.test(basePath)
  ? 'workforce'
  : /^\/objects(\/|$)/.test(basePath)
    ? 'objects'
  : /^\/agents(\/|$)/.test(basePath)
    ? 'agents'
    : 'works';

// Canonical URL + hreflang alternates derive from the same registry as routing.
const site = Astro.site ?? new URL('https://awakenworks.com');
const canonicalPath = localePath(lang, basePath);
const abs = (p: string) => new URL(p, site).href;
const socialImage = withSiteBase(ogImage);

// Umami analytics — privacy-first, no cookies, GDPR-friendly (no consent
// banner needed). The website ID is public (it ships in the page source), so
// we default it here; override via env when self-hosting:
//   PUBLIC_UMAMI_WEBSITE_ID  the website UUID from your Umami dashboard
//   PUBLIC_UMAMI_SRC         script URL (defaults to Umami Cloud)
// Only loads in production builds.
const umamiWebsiteId =
  import.meta.env.PUBLIC_UMAMI_WEBSITE_ID ??
  DEFAULT_UMAMI_WEBSITE_ID;
const umamiSrc =
  import.meta.env.PUBLIC_UMAMI_SRC ?? DEFAULT_UMAMI_SCRIPT_URL;
const enableAnalytics = import.meta.env.PROD && Boolean(umamiWebsiteId);
// The release workflow supplies the exact website commit. Local builds keep an
// explicit `local` value so a published page can never be mistaken for an
// unidentifiable artifact.
const buildRevision = import.meta.env.PUBLIC_AWAKENWORKS_BUILD_REVISION ?? 'local';
---

<!doctype html>
<html lang={locale.htmlLang} data-brand={brand} class="bg-ink-950">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline set:html={appearanceBootstrap({ legacyStorageKeys: ['theme'] })} />
    <script>
      import { captureAttribution } from '../lib/attribution.mjs';

      // One shared state transition owns first/last campaign attribution.
      // Forms project this session-scoped state; CRM owns qualification.
      captureAttribution();

      // One layout owns click dispatch. Navigation and native controls never
      // wait for an analytics request; the existing Umami SDK owns sending.
      document.addEventListener('click', (event) => {
        const element = event.target instanceof Element
          ? event.target.closest('[data-awaken-event]') : null;
        const name = element?.getAttribute('data-awaken-event');
        if (!element || !name || !window.umami?.track) return;
        const prefix = 'data-awaken-event-';
        const data = Object.fromEntries(Array.from(element.attributes)
          .filter((attribute) => attribute.name.startsWith(prefix))
          .map((attribute) => [attribute.name.slice(prefix.length), attribute.value]));
        try {
          void Promise.resolve(window.umami.track(name, data)).catch(() => {});
        } catch { /* Analytics failure leaves the native action intact. */ }
      });
    </script>
    <link rel="icon" type="image/svg+xml" href={withSiteBase('/favicon.svg')} />
    <meta name="generator" content={Astro.generator} />
    <meta name="awakenworks-build-revision" content={buildRevision} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={abs(canonicalPath)} />
    {LANGS.map((alternateLang) => (
      <link rel="alternate" hreflang={localeRegistry[alternateLang].hrefLang} href={abs(localePath(alternateLang, basePath))} />
    ))}
    <link rel="alternate" hreflang="x-default" href={abs(localePath(DEFAULT_LANG, basePath))} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={abs(canonicalPath)} />
    <meta property="og:site_name" content="AwakenWorks" />
    <meta property="og:locale" content={locale.ogLocale} />
    <meta property="og:image" content={abs(socialImage)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {
      isArticle && (
        <>
          {publishedTime && (
            <meta property="article:published_time" content={publishedTime} />
          )}
          {modifiedTime && (
            <meta property="article:modified_time" content={modifiedTime} />
          )}
          {author && <meta property="article:author" content={author} />}
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={abs(socialImage)} />
    {
      jsonLd && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }
    {
      enableAnalytics && (
        <script is:inline defer src={umamiSrc} data-website-id={umamiWebsiteId} />
      )
    }
  </head>
  <body class="bg-ink-950 text-fog-300 antialiased">
    <a class="skip-link" href="#main-content">{ui[lang].common.skip}</a>
    <slot />
  </body>
</html>
