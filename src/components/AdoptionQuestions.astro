---
import { content, type Lang } from '../i18n/content';

interface Props { lang: Lang }

const { lang } = Astro.props;
const questions = content[lang].enterprise.questions;
---

<section id="enterprise-questions" class="scroll-mt-16 border-t border-ink-800 bg-ink-900">
  <div class="mx-auto max-w-4xl px-6 py-10 sm:py-14">
    <p class="eyebrow text-accent-400">{questions.eyebrow}</p>
    <h2 class="mt-4 text-2xl font-semibold text-fog-100 sm:text-3xl">{questions.title}</h2>
    <div class="mt-6 space-y-3">
      {questions.items.map((item) => (
        <details data-adoption-question={item.key} class="rounded-xl border border-ink-700 bg-ink-950 p-4">
          <summary class="cursor-pointer font-medium text-fog-100">{item.question}</summary>
          <p class="mt-3 text-sm leading-7 text-fog-400">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
