---
import { content, type Lang } from '../i18n/content';
import ProductMark from './ProductMark.astro';
import { productPreviewCopy } from '../i18n/ui';

interface Props {
  lang: Lang;
  product: 'objects' | 'workforce';
  compact?: boolean;
}

const { lang, product, compact = false } = Astro.props;
const copy = productPreviewCopy[lang];
const view = { ...copy.views.objects, mark: 'objects' as const, accent: 'text-amber-400', border: 'border-amber-600/45', wash: 'bg-amber-500/5' };
const workforce = copy.workforce;
const loop = content[lang].landing.workforce.loop;
---

<div class="rounded-2xl border border-ink-700 bg-ink-900 p-3 shadow-sm">
  {product === 'workforce' ? (
    <section data-workforce-refund-example data-preview-kind="illustration" aria-label={workforce.caseTitle} class="overflow-hidden rounded-xl border border-ink-700 bg-ink-850">
      <header class="flex flex-wrap items-center justify-between gap-3 border-b border-ink-700 bg-ink-900 px-4 py-4 sm:px-6">
        <div class="flex items-center gap-2.5">
          <ProductMark product="flow" class="h-6 w-6 text-accent-400" />
          <strong class="text-sm text-fog-100">{workforce.brand}</strong>
        </div>
        <span class="rounded-full border border-ink-600 px-3 py-1 text-sm text-fog-400">{workforce.status}</span>
      </header>

      <div class="min-w-0 p-4 sm:p-6">
        <p class="text-sm text-fog-400">{workforce.requestLabel}</p>
        <blockquote class="mt-4 border-l-2 border-accent-500 pl-4 text-base leading-7 text-fog-300">{workforce.request}</blockquote>

        <!-- One content-owned path is rendered here on both Home and Workforce.
             Disclosures reveal an illustration; they perform no business action. -->
        <ol data-workforce-outcome-path class="mt-6 grid gap-3 md:grid-cols-2" aria-label={workforce.pathAria}>
          {loop.stages.map(([title, body], index) => (
            <li>
              <details id={`workforce-stage-${index + 1}`} data-workforce-stage class="h-full rounded-xl border border-ink-700 bg-ink-900 px-4 py-4" open={index === 0}>
                <summary class="cursor-pointer text-base font-semibold text-fog-100">
                  <span class="mr-2 font-mono text-sm text-accent-400">{String(index + 1).padStart(2, '0')}</span>{title}
                </summary>
                <p class="mt-3 text-sm leading-7 text-fog-400">{body}</p>
              </details>
            </li>
          ))}
        </ol>
        <p class="mt-4 text-sm leading-7 text-fog-400">{loop.rule}</p>

        <details data-refund-roles class="mt-5 rounded-xl border border-ink-700 p-4" open={!compact}>
          <summary class="cursor-pointer text-base font-semibold text-fog-100">{workforce.rolesTitle}</summary>
          <div class="mt-3 grid gap-3 lg:grid-cols-3">
            {workforce.roles.map((role) => (
              <article data-workforce-role class="rounded-xl border border-ink-700 bg-ink-900 p-4">
                <p class="text-sm font-medium text-accent-400">{role.label}</p>
                <h4 class="mt-2 text-base font-semibold text-fog-100">{role.title}</h4>
                <p class="mt-3 text-sm leading-7 text-fog-400">{role.body}</p>
              </article>
            ))}
          </div>
        </details>

        <section id="workforce-example-result" data-workforce-acceptance-preview class="mt-6 rounded-xl border border-accent-600/45 bg-accent-500/5 p-4 sm:p-5">
          <p class="text-sm text-accent-400">{workforce.reviewEyebrow}</p>
          <div class="mt-2 flex flex-wrap items-center justify-between gap-3">
            <h3 class="text-lg font-semibold text-fog-100">{workforce.reviewTitle}</h3>
            <strong class="text-sm text-accent-400">{workforce.reviewSummary}</strong>
          </div>
          <dl class="mt-4 grid gap-3 sm:grid-cols-3">
            {workforce.deliverables.map(([name, state]) => (
              <div data-refund-result-record class="rounded-lg border border-ink-700 bg-ink-900 p-3 text-sm">
                <dt class="text-fog-300">{name}</dt>
                <dd class="mt-2 font-medium text-emerald-400">{state}</dd>
              </div>
            ))}
          </dl>
          <p class="mt-4 font-medium text-fog-100">{workforce.decision}</p>
        </section>
      </div>
      <p data-refund-example-boundary class="border-t border-ink-700 bg-ink-900 px-4 py-4 text-sm leading-7 text-fog-400 sm:px-6">{workforce.boundary}</p>
    </section>
  ) : (
  <div class="grid min-h-[390px] overflow-hidden rounded-xl border border-ink-700 bg-ink-850 sm:grid-cols-[165px_1fr]">
    <aside class="hidden border-r border-ink-700 bg-ink-900 p-3 sm:block">
      <div class="mb-5 flex items-center gap-2">
        <span class="grid h-7 w-7 place-items-center rounded-md bg-accent-500 text-onaccent">
          <ProductMark product={view.mark} class="h-4 w-4" />
        </span>
        <span class="text-sm font-semibold text-fog-100">awaken</span>
      </div>
      <div class="space-y-1">
        {view.nav.map((item, i) => (
          <div class={`rounded-md px-2 py-1.5 text-xs ${i === 0 ? 'bg-ink-850 font-semibold text-fog-100 shadow-sm' : 'text-fog-500'}`}>
            {item}
          </div>
        ))}
      </div>
    </aside>

    <div class="min-w-0 p-4 sm:p-5">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <p class="font-mono text-[0.65rem] tracking-wider text-fog-600 uppercase">
            {copy.label}
          </p>
          <h2 class="mt-3 text-xl font-semibold text-fog-100">{view.title}</h2>
          <p class="mt-1 max-w-xl text-xs leading-5 text-fog-500">{view.subtitle}</p>
        </div>
        <span class={`rounded-full border px-3 py-1 font-mono text-[0.65rem] ${view.border} ${view.wash} ${view.accent}`}>
          {view.badge}
        </span>
      </div>

      <div class="mt-5 grid gap-3 md:grid-cols-3">
        {view.facts.map(([label, value]) => (
          <div class="rounded-lg border border-ink-700 bg-ink-900 p-3">
            <p class="text-[0.68rem] text-fog-600">{label}</p>
            <p class="mt-2 text-sm font-semibold text-fog-100">{value}</p>
          </div>
        ))}
      </div>

      <div class="mt-3 overflow-hidden rounded-lg border border-ink-700 bg-ink-900">
        <div class="grid grid-cols-[1fr_1fr_auto] gap-3 border-b border-ink-700 px-3 py-2 font-mono text-[0.65rem] tracking-wider text-fog-600 uppercase">
          {copy.columns.map((column) => <span>{column}</span>)}
        </div>
        {view.rows.map(([name, detail, state], index) => (
          <div class="grid grid-cols-[1fr_1fr_auto] items-center gap-3 border-b border-ink-700 px-3 py-2.5 text-xs last:border-0">
            <span class="min-w-0 font-semibold leading-4 text-fog-100">{name}</span>
            <span class="min-w-0 leading-4 text-fog-500">{detail}</span>
            <span class={`rounded-full border px-2 py-0.5 font-mono text-[0.62rem] ${view.border} ${view.wash} ${view.accent}`}>
              {state}
            </span>
          </div>
        ))}
      </div>

      <p class="mt-4 border-l border-ink-600 pl-4 text-xs leading-5 text-fog-500">{view.boundary}</p>
    </div>
  </div>
  )}
</div>
