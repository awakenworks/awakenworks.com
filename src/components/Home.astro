---
import FunctionalIcon from "./FunctionalIcon.astro";
import { ArrowRight } from "@awaken/ui/icons/data";
import { content, publicProductEntries, localePath, type Lang } from '../i18n/content';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import ProductMark from './ProductMark.astro';
import ProductShowcase from './ProductShowcase.astro';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const home = t.home;
const enterpriseHref = localePath(lang, '/enterprise');
const agentsDocsHref = localePath(lang, '/docs/agents/get-started');
const casesHref = localePath(lang, '/cases');
const productCards = publicProductEntries(lang);
const copy = ui[lang].home;
const businessHref = localePath(lang, t.landing.workforce.ctaSecondary.href);
---

<SiteHeader lang={lang} path="/" />

<main id="main-content" tabindex="-1">
  <section id="home-hero" class="home-hero relative overflow-hidden">
    <div class="grid-backdrop absolute inset-0"></div>
    <div class="relative mx-auto max-w-6xl px-6 py-14 sm:py-20">
      <div>
        <p class="eyebrow text-accent-400">{home.hero.eyebrow}</p>
        <h1 data-home-production-promise class={`home-display-title mt-6 font-semibold text-fog-100 ${copy.titleClass}`}>
          <span class="home-display-title-line">
            <span data-home-title-prefix class={copy.highlightClass}>{home.hero.title}</span> <span data-home-title-highlight class={`text-accent-400 ${copy.highlightClass}`}>{home.hero.titleHighlight}</span>
          </span>
        </h1>
        <p data-home-entity-definition class="mt-3 max-w-3xl text-base leading-7 text-fog-400 sm:text-lg sm:leading-8">
          {home.hero.definition}
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href="#workforce-preview"
            data-awaken-event="workforce_workspace_selected"
            data-awaken-event-location="home-hero"
            data-awaken-event-product="workforce"
            data-awaken-event-destination="workspace-preview"
            class="rounded-xl bg-accent-500 px-6 py-3 font-medium text-onaccent transition hover:bg-accent-400"
          >{home.hero.ctaPrimary}</a>
          <a
            href={agentsDocsHref}
            data-awaken-event="developer_evaluation_selected"
            data-awaken-event-location="home-hero"
            data-awaken-event-product="agents"
            data-awaken-event-destination="quickstart"
            class="rounded-xl border border-ink-600 bg-ink-950/20 px-6 py-3 font-medium text-fog-100 backdrop-blur-sm transition hover:border-fog-500"
          >{home.hero.ctaSecondary}</a>
        </div>
        <p data-home-maturity class="mt-5 text-sm leading-6 text-fog-400">
          {productCards.map((product) => `${product.name}: ${product.status}`).join(' · ')}
        </p>

      </div>
    </div>
  </section>

  <ProductShowcase
    lang={lang}
    product="workforce"
    compact
    caption={ui[lang].landing.workforceCaption}
    eyebrow={home.workflow.eyebrow}
    title={home.workflow.title}
    body={home.workflow.body}
  />

  <section id="home-value" class="scroll-mt-16 border-y border-ink-800 bg-ink-850">
    <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
      <div class="max-w-4xl">
        <p class="eyebrow text-accent-400">{home.advantages.eyebrow}</p>
        <h2 class="mt-5 max-w-4xl text-3xl font-semibold tracking-tight text-fog-100 sm:text-4xl">{home.advantages.title}</h2>
        <p class="mt-6 max-w-3xl text-base leading-7 text-fog-300 sm:text-lg sm:leading-8">{home.advantages.body}</p>
      </div>

      <div class="mt-10 overflow-hidden rounded-xl border border-ink-700 bg-ink-900">
        {home.advantages.items.map((advantage) => (
          <article data-home-value={advantage.key} class="grid gap-3 border-b border-ink-700 p-6 last:border-b-0 sm:grid-cols-[minmax(10rem,0.7fr)_minmax(16rem,1.4fr)_auto] sm:items-center sm:gap-7 sm:px-7">
            <p class="font-mono text-sm font-semibold text-fog-100">{advantage.value}</p>
            <p class="text-sm leading-7 text-fog-400">{advantage.label}</p>
            <a
              href={localePath(lang, advantage.href)}
              data-awaken-event={`home-value-${advantage.key}`}
              class="inline-flex whitespace-nowrap text-xs font-medium text-accent-400 hover:text-accent-300"
            >{advantage.proof} <FunctionalIcon icon={ArrowRight} /></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="home-products" class="scroll-mt-16 border-b border-ink-800 bg-ink-900">
    <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
      <p class="eyebrow text-fog-500">{t.products.eyebrow}</p>
      <h2 class="mt-5 max-w-4xl text-3xl font-semibold tracking-tight text-fog-100 sm:text-4xl">{t.products.title}</h2>
      <div class="mt-10 grid gap-4 md:grid-cols-2">
        {productCards.map((product) => (
          <a
            href={localePath(lang, product.href)}
            data-awaken-event={`home-${product.key}-details`}
            class={`group grid min-w-0 grid-cols-[auto_1fr] gap-4 rounded-xl border border-ink-700 bg-ink-850 p-5 transition hover:border-accent-500`}
          >
            <ProductMark product={product.key} class="h-7 w-7 text-accent-400" />
            <span class="min-w-0">
              <span class="text-base font-semibold text-fog-100">{product.name}</span>
              <span class="mt-1 block text-sm text-fog-400">{product.status}</span>
              <span data-product-role class="mt-3 block text-sm text-fog-400">{product.role}</span>
              <span class="mt-2 block text-sm leading-6 text-fog-400">{product.tagline}</span>
              <span class="mt-4 inline-flex text-sm text-accent-400 transition group-hover:translate-x-1"><FunctionalIcon icon={ArrowRight} /></span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="home-adoption" class="scroll-mt-16 border-b border-ink-800 bg-ink-900">
    <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
      <div class="max-w-4xl">
        <p class="eyebrow text-accent-400">{home.scenarios.eyebrow}</p>
        <h2 class="mt-5 max-w-4xl text-3xl font-semibold tracking-tight text-fog-100 sm:text-4xl">{home.scenarios.title}</h2>
        <p class="mt-6 max-w-3xl text-base leading-7 text-fog-300 sm:text-lg sm:leading-8">{home.scenarios.body}</p>
      </div>
      <div class="mt-10 grid gap-4 lg:grid-cols-3">
        {home.scenarios.items.map((item) => (
          <article
            data-home-adoption={item.key}
            class:list={[
              'flex flex-col rounded-xl border p-6',
              item.featured ? 'border-accent-600/70 bg-accent-500/5' : 'border-ink-700 bg-ink-850',
            ]}
          >
            <div class="flex flex-wrap items-center justify-between gap-3">
              <p class="font-mono text-sm tracking-wider text-fog-500 uppercase">{item.label}</p>
              {item.featured && <span class="rounded-full border border-accent-700/60 px-2.5 py-1 font-mono text-sm text-accent-300">{home.scenarios.featuredLabel}</span>}
            </div>
            <h3 class="mt-4 text-xl font-semibold text-fog-100">{item.title}</h3>
            <p class="mt-4 flex-1 text-sm leading-7 text-fog-400">{item.body}</p>
            <div class="mt-6 border-t border-ink-700 pt-5">
              <p class="font-mono text-sm tracking-wider text-fog-600 uppercase">{home.scenarios.labels.finish}</p>
              <p class="mt-2 text-sm leading-6 text-fog-300">{item.finish}</p>
              <a
                href={item.href === '/enterprise' ? `${enterpriseHref}?product=${item.product}&scenario=${item.key}#apply` : localePath(lang, item.href)}
                data-awaken-event={`scenario-${item.key}-selected`}
                class="mt-5 inline-flex text-sm font-medium text-accent-400 hover:text-accent-300"
              >{home.scenarios.cta} <FunctionalIcon icon={ArrowRight} /></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>



  <section id="home-cases" class="scroll-mt-16 border-b border-ink-800 bg-ink-950">
    <div class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
      <div class="max-w-4xl">
        <p class="eyebrow text-iris-400">{t.cases.eyebrow}</p>
        <h2 class="home-section-title mt-5 text-fog-100">{t.cases.title}</h2>
        <p class="mt-7 max-w-3xl text-lg leading-8 text-fog-300">{t.cases.body}</p>
        <p data-home-case-boundary class="mt-5 max-w-3xl border-l-2 border-iris-500/70 pl-4 text-sm leading-7 text-fog-400">{ui[lang].cases.disclaimer}</p>
      </div>

      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        {t.cases.items.map((item) => (
          <article data-case-card={item.slug} class="flex flex-col rounded-xl border border-ink-700 bg-ink-850 p-7 transition hover:border-iris-600/70">
            <p class="font-mono text-sm uppercase tracking-wider text-iris-400">{item.kind}</p>
            <h3 class="mt-4 text-2xl font-semibold text-fog-100">{item.name}</h3>
            <p class="mt-3 text-sm font-medium text-fog-300">{item.adoption}</p>
            <p class="mt-5 flex-1 text-sm leading-7 text-fog-400">{item.title}</p>
            <div class="mt-7 border-t border-ink-700 pt-5">
              <p class="font-mono text-sm uppercase tracking-wider text-fog-600">{item.status}</p>
              <a
                href={localePath(lang, `/cases/${item.slug}`)}
                data-awaken-event={`home-case-${item.slug}`}
                class="mt-4 inline-flex font-medium text-iris-400"
              >{item.cta} <FunctionalIcon icon={ArrowRight} /></a>
            </div>
          </article>
        ))}
      </div>

      <a href={casesHref} data-awaken-event="home-all-cases" class="mt-10 inline-flex rounded-xl border border-ink-600 px-5 py-3 font-medium text-fog-200 transition hover:border-iris-500">
        {copy.allCases} <FunctionalIcon icon={ArrowRight} />
      </a>
    </div>
  </section>

  <section id="home-cta" class="home-cta border-t border-ink-800 bg-ink-900">
    <div class="mx-auto max-w-5xl px-6 py-20 text-center sm:py-24">
      <p class="eyebrow text-accent-400">{home.cta.eyebrow}</p>
      <h2 class="home-section-title mx-auto mt-5 max-w-4xl text-fog-100">{home.cta.title}</h2>
      <p class="mx-auto mt-7 max-w-2xl text-lg leading-8 text-fog-300">{home.cta.body}</p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href={businessHref} data-awaken-event="business_job_evaluation_selected" data-awaken-event-location="home-closing" data-awaken-event-product="workforce" data-awaken-event-destination="enterprise" class="rounded-xl bg-accent-500 px-6 py-3 font-medium text-onaccent transition hover:bg-accent-400">{home.cta.primary}</a>
        <a href={agentsDocsHref} data-awaken-event="developer_evaluation_selected" data-awaken-event-location="home-closing" data-awaken-event-product="agents" data-awaken-event-destination="quickstart" class="rounded-xl border border-ink-600 px-6 py-3 font-medium text-fog-100 transition hover:border-fog-500">{home.cta.secondary}</a>
      </div>
    </div>
  </section>
</main>

<SiteFooter lang={lang} />

<style>
  .home-hero {
    background:
      radial-gradient(circle at 12% 38%, color-mix(in oklch, var(--color-accent-400) 14%, transparent), transparent 24%),
      radial-gradient(circle at 88% 42%, color-mix(in oklch, var(--color-iris-400) 20%, transparent), transparent 26%),
      linear-gradient(180deg, var(--color-ink-900), var(--color-ink-950));
  }

  .home-display-title {
    font-size: clamp(3rem, 5vw, 4.5rem);
    line-height: 0.98;
    letter-spacing: -0.06em;
    text-wrap: balance;
  }

  .home-display-title-zh {
    font-size: clamp(2.8rem, 4.4vw, 4.5rem);
  }

  @media (min-width: 1024px) {
    .home-display-title-line {
      white-space: normal;
    }
  }

  .home-section-title {
    max-width: 56rem;
    font-size: clamp(2.5rem, 5.2vw, 5rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }

  .home-cta {
    background:
      radial-gradient(circle at 50% 0%, color-mix(in oklch, var(--color-accent-500) 16%, transparent), transparent 48%),
      var(--color-ink-900);
  }

  @media (max-width: 639px) {
    .home-display-title {
      font-size: 2.3rem;
      letter-spacing: -0.05em;
    }
  }
</style>
