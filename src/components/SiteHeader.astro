---
import { AWAKEN_GITHUB_URL, content, localePath, type Lang } from '../i18n/content';
import ProductMark from './ProductMark.astro';
import { LANGS, localeRegistry } from '../i18n/locales';

interface Props {
  lang: Lang;
  // Logical path (without locale prefix) of the current page, so the
  // language switch points at the same page in the other locale.
  path?: string;
}

const { lang, path = '/' } = Astro.props;
const t = content[lang];
const home = localePath(lang, '/');
const alternateLocales = LANGS.filter((candidate) => candidate !== lang);
const docsHref = localePath(lang, '/docs');
const enterpriseHref = localePath(lang, '/enterprise');
const githubHref = AWAKEN_GITHUB_URL;
const startHref = localePath(lang, '/docs/agents/get-started');

const navLinks = [
  { path: '/agents', label: t.nav.managed, href: localePath(lang, '/agents') },
  { path: '/objects', label: t.nav.objects, href: localePath(lang, '/objects') },
  { path: '/workforce', label: t.nav.workforce, href: localePath(lang, '/workforce') },
  { path: '/cases', label: t.nav.cases, href: localePath(lang, '/cases') },
  { path: '/blog', label: t.nav.blog, href: localePath(lang, '/blog') },
];
const isActive = (candidate: string) =>
  path === candidate || path.startsWith(`${candidate}/`);
const docsActive = isActive('/docs');
const enterpriseActive = isActive('/enterprise');
---

<header
  class="sticky top-0 z-50 border-b border-ink-700/60 bg-ink-950/80 backdrop-blur-md"
>
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
    <a href={home} class="flex items-center gap-2 font-semibold text-fog-100">
      <ProductMark product="works" class="h-5 w-5" />
      AwakenWorks
    </a>
    <div class="flex items-center gap-3 text-sm sm:gap-5">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.path) ? 'page' : undefined}
            class:list={[
              'hidden border-b border-transparent py-1 text-fog-300 transition hover:text-fog-100 md:block',
              isActive(link.path) && 'border-accent-400 text-fog-100',
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <a href={docsHref} aria-current={docsActive ? 'page' : undefined} class:list={['hidden border-b border-transparent py-1 text-fog-300 transition hover:text-fog-100 sm:block', docsActive && 'border-accent-400 text-fog-100']}
        >{t.nav.docs}</a
      >
      <a href={githubHref} data-umami-event="github_star_selected" data-umami-event-location="header" class="hidden text-fog-300 hover:text-fog-100 sm:block"
        >{t.nav.github}</a
      >
      <a
        href={enterpriseHref}
        aria-current={enterpriseActive ? 'page' : undefined}
        data-umami-event="enterprise_intent_selected"
        class="hidden rounded-full bg-accent-500 px-3.5 py-1.5 text-xs font-semibold text-onaccent transition hover:bg-accent-400 lg:inline-flex"
      >{t.nav.enterprise}</a>
      <button
        data-theme-toggle
        type="button"
        aria-label={t.nav.theme}
        class="flex h-7 w-7 items-center justify-center rounded-full border border-ink-600 text-fog-300 transition hover:border-fog-500 hover:text-fog-100"
      >
        <svg
          class="icon-when-dark h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><circle cx="12" cy="12" r="4"></circle><path
            d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
          ></path></svg
        >
        <svg
          class="icon-when-light h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg
        >
      </button>
      {alternateLocales.map((alternateLang) => (
        <a
          href={localePath(alternateLang, path)}
          hreflang={localeRegistry[alternateLang].hrefLang}
          lang={localeRegistry[alternateLang].htmlLang}
          class="rounded-full border border-ink-600 px-3 py-1 font-mono text-xs text-fog-300 hover:border-fog-500 hover:text-fog-100"
        >{localeRegistry[alternateLang].shortName}</a>
      ))}
      <details class="relative md:hidden">
        <summary class="cursor-pointer list-none rounded-full border border-ink-600 px-3 py-1 text-xs text-fog-300 hover:border-fog-500 hover:text-fog-100">
          {t.nav.menu}
        </summary>
        <div class="absolute right-0 mt-3 grid min-w-56 gap-1 rounded-xl border border-ink-700 bg-ink-950 p-3 shadow-2xl">
          {navLinks.map((link) => <a href={link.href} aria-current={isActive(link.path) ? 'page' : undefined} class:list={['rounded-lg px-3 py-2 text-fog-300 hover:bg-ink-850 hover:text-fog-100', isActive(link.path) && 'bg-ink-850 text-fog-100']}>{link.label}</a>)}
          <a href={docsHref} aria-current={docsActive ? 'page' : undefined} class:list={['rounded-lg px-3 py-2 text-fog-300 hover:bg-ink-850 hover:text-fog-100', docsActive && 'bg-ink-850 text-fog-100']}>{t.nav.docs}</a>
          <a href={startHref} data-umami-event="developer_evaluation_selected" class="rounded-lg px-3 py-2 text-fog-300 hover:bg-ink-850 hover:text-fog-100">{t.nav.run}</a>
          <a href={githubHref} data-umami-event="github_star_selected" data-umami-event-location="mobile-menu" class="rounded-lg px-3 py-2 text-fog-300 hover:bg-ink-850 hover:text-fog-100">{t.nav.github}</a>
          <a href={enterpriseHref} aria-current={enterpriseActive ? 'page' : undefined} data-umami-event="enterprise_intent_selected" class="mt-1 rounded-lg bg-accent-500 px-3 py-2 font-semibold text-onaccent">{t.nav.enterprise}</a>
        </div>
      </details>
    </div>
  </nav>
</header>
