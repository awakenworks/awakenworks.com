---
import { content, publicProductEntries, localePath, REFUND_SCENARIO_KEY, type Lang } from '../i18n/content';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
  product: string;
  align?: 'left' | 'center';
}

const { lang, product, align = 'left' } = Astro.props;
const intent = 'cooperation' as const;
const w = content[lang].waitlist;
const variant = w.variants.cooperation;
const endpoint =
  import.meta.env.PUBLIC_OPPORTUNITY_ENDPOINT
  ?? 'https://formspree.io/f/mrewzorl';
const rowAlign = align === 'center' ? 'sm:justify-center' : 'sm:justify-start';
const source = Astro.url.pathname;
const privacyHref = localePath(lang, '/privacy');
const frequencyOptions = ui[lang].landing.frequencies;
const roleOptions = ui[lang].landing.roles;
const stageOptions = ui[lang].landing.stages;
const blockerOptions = ui[lang].landing.blockers;
const systemOptions = ui[lang].landing.systems;
const timingOptions = ui[lang].landing.timings;
const chooseOption = ui[lang].landing.chooseOption;
const formSteps = ui[lang].landing.formSteps;
const selectedScenarioPrefix = ui[lang].landing.selectedScenario;
const selectedProductPrefix = ui[lang].landing.selectedProduct;
const productOptions = publicProductEntries(lang).map((product) => [product.key, `${product.name} · ${product.status}`]);
const caseLabels = Object.fromEntries(content[lang].cases.items.map((item) => [item.slug, item.name]));
const scenarioLabels = {
  ...content[lang].enterprise.contextLabels,
  [REFUND_SCENARIO_KEY]: content[lang].landing.workforce.loop.eyebrow,
};
---

<form
  class="opportunity-form"
  action={endpoint}
  method="POST"
  data-opportunity-form
  data-intent={intent}
  data-source={source}
  data-success={variant.success}
  data-error={w.error}
  data-submitting={variant.submitting}
  data-draft-blocked={w.draftBlocked}
  data-draft-restored={w.draftRestored}
  data-scenario-labels={JSON.stringify(scenarioLabels)}
  data-case-labels={JSON.stringify(caseLabels)}
>
  <input type="hidden" name="intent" value={intent} />
  <input type="hidden" name="capability_context" value="" />
  <input type="hidden" name="reference_case" value="" />
  <input type="hidden" name="lang" value={lang} />
  <input type="hidden" name="source_page" value={source} />
  <input type="hidden" name="landing_page" value="" />
  <input type="hidden" name="referrer" value="" />
  <input type="hidden" name="utm_source" value="" />
  <input type="hidden" name="utm_medium" value="" />
  <input type="hidden" name="utm_campaign" value="" />
  <input type="hidden" name="utm_content" value="" />
  <input type="hidden" name="first_landing_page" value="" />
  <input type="hidden" name="first_referrer" value="" />
  <input type="hidden" name="first_utm_source" value="" />
  <input type="hidden" name="first_utm_medium" value="" />
  <input type="hidden" name="first_utm_campaign" value="" />
  <input type="hidden" name="first_utm_content" value="" />
  <input type="hidden" name="scenario_context" value="" />
  <input type="hidden" name="submission_id" value="" />
  <input type="hidden" name="submitted_at" value="" />
  <input type="hidden" name="page_url" value="" />
  <input type="hidden" name="_subject" value={variant.subject} />
  <label class="sr-only">
    Leave this field empty
    <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
  </label>
  <div data-opportunity-fields class={`grid gap-6 ${rowAlign}`}>
    <p data-scenario-context class="rounded-lg border border-accent-700/50 bg-accent-500/5 px-4 py-3 text-sm text-accent-300" hidden>
      {selectedScenarioPrefix} <strong data-scenario-context-label></strong>
    </p>
    <fieldset data-form-step="request" class="grid gap-4">
      <legend class="mb-4 text-base font-semibold text-fog-100">{formSteps[0]}</legend>
      <label class="grid gap-2 text-sm text-fog-300">
        {selectedProductPrefix}
        <select name="product" class="w-full rounded-lg border border-accent-700/50 bg-accent-500/5 px-4 py-3 font-medium text-accent-300 focus:border-accent-500">
          {productOptions.map(([value, label]) => <option value={value} selected={value === product}>{label}</option>)}
        </select>
        <span data-product-help class="text-sm leading-6 text-fog-400">{content[lang].enterprise.form.productHelp}</span>
      </label>
      <label class="grid gap-2 text-sm text-fog-300">
        {w.fields.scenario}
        <textarea name="job" required maxlength="1200" rows="3" placeholder={w.jobPlaceholder} class="w-full rounded-lg border border-ink-600 bg-ink-850 px-4 py-3 text-fog-100 placeholder:text-fog-500 focus:border-accent-500"></textarea>
      </label>
    </fieldset>
    <fieldset data-form-step="contact" class="grid gap-4">
      <legend class="mb-4 text-base font-semibold text-fog-100">{formSteps[1]}</legend>
      <label class="grid gap-2 text-sm text-fog-300">
        {w.fields.email}
        <input type="email" name="email" required maxlength="320" autocomplete="email" placeholder={w.placeholder} class="w-full rounded-lg border border-ink-600 bg-ink-850 px-4 py-3 text-fog-100 placeholder:text-fog-500 focus:border-accent-500" />
      </label>
    </fieldset>
    <details data-opportunity-details class="rounded-xl border border-ink-700 bg-ink-900">
      <summary class="cursor-pointer px-4 py-4 text-sm font-medium text-fog-200">{formSteps[2]}</summary>
      <fieldset data-form-step="scope" class="grid gap-4 border-t border-ink-700 p-4 sm:p-5">
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="grid gap-2 text-sm text-fog-300">
            {w.fields.company}
            <input type="text" name="company" maxlength="160" autocomplete="organization" class="w-full rounded-lg border border-ink-600 bg-ink-850 px-4 py-3 text-fog-100 focus:border-accent-500" />
          </label>
          <label class="grid gap-2 text-sm text-fog-300">
            {w.fields.role}
            <select name="role" autocomplete="organization-title" class="w-full rounded-lg border border-ink-600 bg-ink-850 px-4 py-3 text-fog-100 focus:border-accent-500">
              <option value="" selected>{chooseOption}</option>
              {roleOptions.map(([value, label]) => <option value={value}>{label}</option>)}
            </select>
          </label>
        </div>
        <label class="grid gap-2 text-sm text-fog-300">
          {w.fields.stage}
          <select name="current_stage" class="w-full rounded-lg border border-ink-600 bg-ink-850 px-4 py-3 text-fog-100 focus:border-accent-500">
            <option value="" selected>{chooseOption}</option>
            {stageOptions.map(([value, label]) => <option value={value}>{label}</option>)}
          </select>
        </label>
        <label class="grid gap-2 text-sm text-fog-300">
          {w.fields.loss}
          <select name="current_loss" class="w-full rounded-lg border border-ink-600 bg-ink-850 px-4 py-3 text-fog-100 focus:border-accent-500">
            <option value="" selected>{chooseOption}</option>
            {blockerOptions.map(([value, label]) => <option value={value}>{label}</option>)}
          </select>
        </label>
        <fieldset class="grid gap-3">
          <legend class="text-sm text-fog-300">{w.fields.systems}</legend>
          <div class="grid gap-2 sm:grid-cols-2">
            {systemOptions.map(([value, label]) => (
              <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-ink-700 bg-ink-850 px-3 py-2.5 text-sm leading-5 text-fog-300 transition hover:border-ink-600">
                <input type="checkbox" name="systems_and_risks" value={value} class="mt-0.5 h-4 w-4 shrink-0 accent-[var(--color-accent-500)]" />
                <span>{label}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="grid gap-2 text-sm text-fog-300">
            {w.fields.frequency}
            <select name="frequency" class="w-full rounded-lg border border-ink-600 bg-ink-850 px-4 py-3 text-fog-100 focus:border-accent-500">
              <option value="" selected>{chooseOption}</option>
              {frequencyOptions.map(([value, label]) => <option value={value}>{label}</option>)}
            </select>
          </label>
          <label class="grid gap-2 text-sm text-fog-300">
            {w.fields.timing}
            <select name="target_timing" class="w-full rounded-lg border border-ink-600 bg-ink-850 px-4 py-3 text-fog-100 focus:border-accent-500">
              <option value="" selected>{chooseOption}</option>
              {timingOptions.map(([value, label]) => <option value={value}>{label}</option>)}
            </select>
          </label>
        </div>
        <label class="grid gap-2 text-sm text-fog-300">
          {w.fields.additional}
          <textarea name="additional_context" maxlength="2000" rows="3" placeholder={w.additionalPlaceholder} class="w-full rounded-lg border border-ink-600 bg-ink-850 px-4 py-3 text-fog-100 placeholder:text-fog-500 focus:border-accent-500"></textarea>
        </label>
      </fieldset>
    </details>
    <label class="flex items-start gap-3 text-sm leading-6 text-fog-400">
      <input type="checkbox" name="contact_consent" value="yes" required class="mt-1 h-4 w-4 shrink-0 accent-[var(--color-accent-500)]" />
      <span>{w.privacyPrefix} <a href={privacyHref} class="text-accent-400 underline underline-offset-2">{w.privacyLabel}</a>.</span>
    </label>
    <button
      type="submit"
      class="justify-self-start rounded-lg bg-accent-500 px-6 py-3 font-medium text-onaccent transition hover:bg-accent-400 disabled:opacity-60"
      >{variant.button}</button
    >
  </div>
  <section data-opportunity-success role="status" aria-live="polite" tabindex="-1" class="rounded-2xl border border-accent-700/60 bg-accent-500/5 p-6 outline-none" hidden>
    <p class="eyebrow text-accent-400">{variant.success}</p>
    <p class="mt-4 leading-7 text-fog-300">{variant.successBody}</p>
    <ol class="mt-6 space-y-4">
      {variant.successSteps.map((step, index) => (
        <li data-opportunity-success-step class="grid grid-cols-[2rem_1fr] gap-3 text-sm leading-6 text-fog-400">
          <span class="font-mono text-xs text-accent-400">{String(index + 1).padStart(2, '0')}</span>
          <span>{step}</span>
        </li>
      ))}
    </ol>
  </section>
  <p class={`opportunity-message mt-3 text-sm ${align === 'center' ? 'text-center' : ''}`} role="status" aria-live="polite" tabindex="-1" hidden></p>
</form>

<script>
  import { attributionFormValues, captureAttribution } from '../lib/attribution.mjs';
  import { trackEvent } from '../config/analytics.mjs';

  if (!window.__opportunityFormInit) {
    window.__opportunityFormInit = true;

    function trackOpportunity(name, form, details = {}) {
      trackEvent(name, {
        intent: form.dataset.intent,
        source: form.dataset.source,
        scenario: form.elements.namedItem('scenario_context')?.value || undefined,
        product: form.elements.namedItem('product')?.value || undefined,
        reference_case: form.elements.namedItem('reference_case')?.value || undefined,
        location: 'enterprise-apply',
        ...details,
      });
    }

    function hydrateAttribution(form) {
      var params = new URLSearchParams(window.location.search);
      var attribution = attributionFormValues(captureAttribution());
      var product = form.elements.namedItem('product');
      var requestedProduct = params.get('product');
      var scenario = form.elements.namedItem('scenario_context');
      var requestedScenario = params.get('scenario');
      var requestedCase = params.get('reference_case');
      var referenceCase = form.elements.namedItem('reference_case');
      var caseLabels = {};
      try { caseLabels = JSON.parse(form.dataset.caseLabels || '{}'); } catch (_error) {}
      if (referenceCase && requestedCase && Object.prototype.hasOwnProperty.call(caseLabels, requestedCase)) {
        referenceCase.value = requestedCase;
      }
      var submissionId = form.elements.namedItem('submission_id');
      var submittedAt = form.elements.namedItem('submitted_at');
      var pageUrl = form.elements.namedItem('page_url');
      var scenarioLabels = {};
      try {
        scenarioLabels = JSON.parse(form.dataset.scenarioLabels || '{}');
      } catch (_error) {}
      Object.entries(attribution).forEach(function ([key, value]) {
        var field = form.elements.namedItem(key);
        if (field) field.value = value;
      });
      if (submissionId && !submissionId.value) {
        submissionId.value = globalThis.crypto?.randomUUID?.()
          ?? 'web-' + Date.now() + '-' + Math.random().toString(16).slice(2);
      }
      if (submittedAt) submittedAt.value = new Date().toISOString();
      if (pageUrl) pageUrl.value = window.location.href;
      // The existing handler retains old Objects intent inside Workforce.
      var capability = form.elements.namedItem('capability_context');
      if (requestedProduct === 'objects') {
        requestedProduct = 'workforce';
        if (capability) capability.value = 'objects';
      }
      if (product && requestedProduct && Array.from(product.options).some((option) => option.value === requestedProduct)) {
        product.value = requestedProduct;
      }
      if (scenario && requestedScenario && Object.prototype.hasOwnProperty.call(scenarioLabels, requestedScenario)) {
        scenario.value = requestedScenario;
        var context = form.querySelector('[data-scenario-context]');
        var label = form.querySelector('[data-scenario-context-label]');
        if (context && label) {
          label.textContent = scenarioLabels[requestedScenario];
          context.hidden = false;
        }
      }
    }

    // This form owns one short-lived, one-use transfer across a language reload.
    // It is never URL data or analytics data; no draft is kept after restoration.
    const localeDraftKey = 'awakenworks_opportunity_locale_draft';
    const draftFields = ['email', 'company', 'role', 'product', 'current_stage', 'job', 'current_loss', 'systems_and_risks', 'frequency', 'target_timing', 'additional_context', 'contact_consent'];
    function readDraft(form, lang) {
      const fields = Object.fromEntries(draftFields.map((name) => [name,
        Array.from(form.querySelectorAll('[name="' + name + '"]')).filter((field) => field.type !== 'checkbox' || field.checked).map((field) => field.value),
      ]));
      return { schema: 1, lang, expiresAt: Date.now() + 10 * 60 * 1000, fields, detailsOpen: Boolean(form.querySelector('[data-opportunity-details]')?.open) };
    }
    function restoreDraft(form) {
      let draft;
      let raw;
      try {
        raw = sessionStorage.getItem(localeDraftKey);
        sessionStorage.removeItem(localeDraftKey);
      } catch (_error) { return; }
      if (!raw || raw.length > 16_384) return;
      try { draft = JSON.parse(raw); } catch (_error) { return; }
      if (draft?.schema !== 1 || draft.lang !== form.elements.namedItem('lang').value || !Number.isFinite(draft.expiresAt) || draft.expiresAt < Date.now() || draft.expiresAt > Date.now() + 10 * 60 * 1000 || !draft.fields || typeof draft.fields !== 'object' || Array.isArray(draft.fields)) return;
      for (const name of draftFields) {
        const values = draft.fields[name];
        if (!Array.isArray(values) || values.some((value) => typeof value !== 'string' || value.length > 2048)) continue;
        for (const field of form.querySelectorAll('[name="' + name + '"]')) {
          if (field.type === 'checkbox') field.checked = values.includes(field.value);
          else if (field instanceof HTMLSelectElement) {
            if (Array.from(field.options).some((option) => option.value === values[0])) field.value = values[0];
          } else if (values[0] !== undefined) field.value = values[0].slice(0, field.maxLength > 0 ? field.maxLength : 2048);
        }
      }
      if (draft.detailsOpen === true) form.querySelector('[data-opportunity-details]').open = true;
      const message = form.querySelector('.opportunity-message');
      message.textContent = form.dataset.draftRestored;
      message.hidden = false;
    }
    document.querySelectorAll('[data-opportunity-form]').forEach((form) => {
      hydrateAttribution(form);
      form.dataset.initialProduct = form.elements.namedItem('product').value;
      restoreDraft(form);
    });
    document.addEventListener('click', (event) => {
      const link = event.target instanceof Element ? event.target.closest('a[data-locale-switch]') : null;
      if (!link || event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || link.target === '_blank') return;
      const form = document.querySelector('[data-opportunity-form]');
      if (!form || form.querySelector('[data-opportunity-fields]').hidden) return;
      const draft = readDraft(form, link.dataset.localeSwitch);
      const hasDraft = Object.entries(draft.fields).some(([name, values]) => name === 'product' ? values[0] !== form.dataset.initialProduct : values.some(Boolean));
      if (!hasDraft) return;
      try {
        const value = JSON.stringify(draft);
        sessionStorage.setItem(localeDraftKey, value);
        if (sessionStorage.getItem(localeDraftKey) !== value) throw new Error('Draft storage unavailable');
      } catch (_error) {
        event.preventDefault();
        const message = form.querySelector('.opportunity-message');
        message.textContent = form.dataset.draftBlocked;
        message.hidden = false;
        message.focus();
      }
    });


    document.addEventListener('focusin', function (event) {
      var form = event.target.closest('[data-opportunity-form]');
      if (!form || form.dataset.started === 'true') return;
      form.dataset.started = 'true';
      trackOpportunity('opportunity_form_started', form);
    });

    document.addEventListener('submit', async function (event) {
      var form = event.target.closest('[data-opportunity-form]');
      if (!form) return;
      event.preventDefault();
      if (form.getAttribute('aria-busy') === 'true') return;
      var message = form.querySelector('.opportunity-message');
      var button = form.querySelector('button[type="submit"]');
      var buttonLabel = button.textContent;
      button.disabled = true;
      form.setAttribute('aria-busy', 'true');
      button.textContent = form.dataset.submitting;
      var failureReason = 'network_error';
      try {
        var response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!response.ok) {
          failureReason = 'non_2xx';
          throw new Error();
        }
        try { sessionStorage.removeItem(localeDraftKey); } catch (_error) {}
        trackOpportunity('opportunity_form_submitted', form);
        var fields = form.querySelector('[data-opportunity-fields]');
        var success = form.querySelector('[data-opportunity-success]');
        if (fields) fields.hidden = true;
        if (success) {
          success.hidden = false;
          success.focus();
        }
        message.hidden = true;
      } catch (_error) {
        trackOpportunity('opportunity_form_submission_failed', form, { reason: failureReason });
        message.textContent = form.dataset.error;
        message.style.color = 'var(--color-rust-500)';
        message.hidden = false;
      } finally {
        button.disabled = false;
        button.textContent = buttonLabel;
        form.removeAttribute('aria-busy');
      }
    });
  }
</script>
