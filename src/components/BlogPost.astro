---
import { render, type CollectionEntry } from 'astro:content';
import { localePath, type Lang } from '../i18n/content';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
  post: CollectionEntry<'blog'>;
}
const { lang, post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---

<SiteHeader lang={lang} path="/blog" />

<main class="mx-auto max-w-2xl px-6 py-20 sm:py-24">
  <a
    href={localePath(lang, '/blog')}
    class="font-mono text-xs text-fog-500 hover:text-fog-100"
    >← {ui[lang].blog.back}</a
  >
  <p class="mt-8 font-mono text-xs text-fog-600">
    {fmt(post.data.date)} · {post.data.author}
    {post.data.tags.length > 0 && <> · {post.data.tags.join(' · ')}</>}
  </p>
  <h1 class="mt-3 text-3xl font-semibold tracking-tight text-fog-100 sm:text-4xl">
    {post.data.title}
  </h1>
  <p class="mt-4 text-lg text-fog-300">{post.data.description}</p>
  <article class="prose blog-prose mt-10">
    <Content />
  </article>
</main>

<SiteFooter lang={lang} />
